{
  "rules": {
    "config": {
      "teacher": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      },
      "className": {
        ".read": true,
        ".write": "{{T}}"
      },
      "teacherName": {
        ".read": "{{TM}}",
        ".write": "{{T}}"
      },
      "settings": {
        ".read": "{{TM}}",
        ".write": "{{T}}"
      },
      "econ": {
        ".read": "{{TM}}",
        ".write": "{{T}}"
      }
    },
    "users": {
      ".read": "{{TM}}",
      "$uid": {
        ".write": "{{T}}",
        "pwc": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists()"
        }
      }
    },
    "secrets": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$uid": {
        "pw": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 100"
        }
      }
    },
    "activities": {
      ".read": "{{T}}",
      ".write": "{{T}}"
    },
    "entries": {
      ".read": "{{T}}",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('config/teacher').val() === auth.uid)",
        ".write": "{{T}}",
        "$eid": {
          ".write": "{{SELF}} && ({{ENTRY_STUDENT}} || {{ENTRY_SYSTEM}} || (data.exists() && data.child('status').val() === 'pending' && !newData.exists()))"
        }
      }
    },
    "openUnits": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "levels": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "hanja": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('users/' + auth.uid).exists() && newData.exists() && (data.child('version').val() !== 2 || newData.child('version').val() === 2) && (!data.child('baseline').exists() || newData.child('baseline').exists())",
        ".validate": "!newData.child('version').exists() || (newData.child('version').val() === 2 && newData.child('learned').isNumber() && newData.child('learned').val() >= 0 && newData.child('learned').val() <= 300 && newData.child('level').isNumber() && newData.child('level').val() >= 0 && newData.child('level').val() <= 5 && newData.child('score').isNumber() && newData.child('score').val() >= 1000)",
        "baseline": {
          ".validate": "newData.hasChildren(['right','total','ts']) && newData.child('total').val() === 30 && newData.child('right').val() >= 0 && newData.child('right').val() <= 30 && (!data.exists() || (newData.child('right').val() === data.child('right').val() && newData.child('ts').val() === data.child('ts').val()))"
        },
        "baselinePlan": {
          "$index": {
            ".validate": "!data.exists() || (newData.child('h').val() === data.child('h').val() && newData.child('type').val() === data.child('type').val())"
          }
        },
        "days": {
          "$date": {
            ".validate": "newData.child('chars').isString() && newData.child('chars').val().length > 0 && newData.child('chars').val().length <= 20 && (newData.child('reward').val() === 5 || newData.child('reward').val() === 10 || newData.child('reward').val() === 15) && (!data.exists() || (newData.child('chars').val() === data.child('chars').val() && newData.child('from').val() === data.child('from').val() && newData.child('to').val() === data.child('to').val() && newData.child('stage').val() === data.child('stage').val() && newData.child('reward').val() === data.child('reward').val() && (data.child('done').val() !== true || newData.child('done').val() === true)))"
          }
        }
      }
    },
    "standings": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "myDetail": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$month": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "seasons": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "gov": {
      ".read": "{{TM}}",
      ".write": "{{T}}",
      "cash": {
        ".validate": "newData.isNumber() && newData.parent().child('last').val() !== data.parent().child('last').val() && {{GOVCASHOK}}"
      },
      "last": {
        ".validate": "newData.isString() && {{NR2}}.child('feed/' + newData.val() + '/u').val() === '_gov' && !root.child('feed/' + newData.val()).exists()"
      },
      "$other": {
        ".validate": false
      }
    },
    "acct": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "cash": {
          ".write": "{{SELF}} && newData.exists() && (newData.val() >= 0 || newData.val() >= data.val())",
          ".validate": "newData.isNumber() && newData.parent().child('last').val() !== data.parent().child('last').val() && {{CASHOK}}"
        },
        "last": {
          ".write": "{{SELF}} && newData.exists()",
          ".validate": "newData.isString() && {{NR3}}.child('feed/' + newData.val() + '/u').val() === $uid && !root.child('feed/' + newData.val()).exists()"
        },
        "items": {
          "$iid": {
            ".write": "{{ITEMW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          }
        },
        "dep": {
          "$did": {
            ".write": "{{DEPW}}",
            ".validate": "newData.hasChildren(['p', 'i', 'r', 's', 'dd']) && newData.child('p').isNumber() && newData.child('i').isNumber() && newData.child('r').isNumber() && newData.child('s').isNumber() && newData.child('dd').isNumber()"
          }
        },
        "hold": {
          "$sid": {
            ".write": "{{HOLDW}}",
            "q": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "c": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "tc": {
          ".write": "{{TCW}}",
          ".validate": "newData.hasChildren(['d', 'n']) && newData.child('d').isNumber() && newData.child('n').isNumber()"
        },
        "grade": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "avatar": {
          ".write": "{{AVATARW}}",
          ".validate": "newData.hasChildren(['style', 'seed'])"
        },
        "avs": {
          "$aid": {
            ".write": "{{AVSW}}",
            ".validate": "newData.hasChildren(['style', 'seed']) && newData.child('style').isString() && newData.child('style').val().length <= 30"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feed": {
      ".read": "{{T}} || ({{M}} && query.orderByChild === 'u' && query.equalTo === auth.uid)",
      ".write": "{{T}}",
      ".indexOn": [
        "u",
        "t"
      ],
      "$lid": {
        ".write": "{{M}} && !data.exists() && newData.exists() && newData.child('u').val() === auth.uid && newData.child('by').val() === 'S' && {{STUOP}}",
        ".validate": "newData.hasChildren(['u', 'k', 'a', 't', 'by']) && newData.child('u').isString() && newData.child('t').val() === now && (newData.child('by').val() === 'T' || newData.child('by').val() === 'S') && {{TIED}}",
        "k": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "a": {
          ".validate": "newData.isNumber()"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "i": {
          ".validate": "newData.isString()"
        },
        "s": {
          ".validate": "newData.isString()"
        },
        "d": {
          ".validate": "newData.isString()"
        },
        "q": {
          ".validate": "newData.isNumber()"
        },
        "p": {
          ".validate": "newData.isNumber()"
        },
        "g": {
          ".validate": "newData.isNumber()"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "c": {
          ".validate": "newData.isNumber()"
        },
        "src": {
          ".validate": "newData.isString()"
        },
        "pr": {
          ".validate": "newData.isString()"
        },
        "j": {
          ".validate": "newData.isString()"
        },
        "u": {
          ".validate": true
        },
        "t": {
          ".validate": true
        },
        "by": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feedMark": {
      ".read": "{{T}}",
      ".write": "{{T}}"
    },
    "store": {
      ".write": "{{T}}",
      "items": {
        ".read": "{{TM}}",
        "$iid": {
          "st": {
            ".write": "{{STOCKW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "r": {
            ".write": "{{RAISEW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "p": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        }
      },
      "contrib": {
        ".read": "{{T}}",
        "$iid": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && {{RAISEW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "jobs": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "market": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "pub": {
      ".read": true,
      ".write": "{{T}}",
      "symbols": {
        ".validate": "newData.isString() && newData.val().length <= 500"
      },
      "$other": {
        ".validate": false
      }
    },
    "quests": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "qprog": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$qid": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$per": {
            ".write": "{{SELF}} && ((!data.exists() && {{QREQ}}) || (data.exists() && data.child('st').val() === 'no' && {{QREQ}}) || (data.exists() && data.child('st').val() === 'req' && !newData.exists()))",
            ".validate": "newData.hasChildren(['st', 't'])",
            "st": {
              ".validate": "newData.val() === 'req' || newData.val() === 'ok' || newData.val() === 'no'"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "txt": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "img": {
              ".validate": "newData.val() === true"
            },
            "rt": {
              ".validate": "newData.isNumber()"
            },
            "why": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "lid": {
              ".validate": "newData.isString()"
            },
            "imp": {
              ".validate": "newData.val() === true"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "qimg": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$qid": {
        "$uid": {
          "$per": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "{{QIMGW}}"
          }
        }
      }
    },
    "boards": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "bposts": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}}",
        "$pid": {
          ".write": "{{BPOSTW}}",
          ".validate": "newData.hasChildren(['u', 't']) && newData.child('u').isString() && newData.child('t').isNumber()",
          "u": {
            ".validate": true
          },
          "t": {
            ".validate": true
          },
          "e": {
            ".validate": "newData.isNumber()"
          },
          "ti": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "tx": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "img": {
            ".validate": "newData.val() === true"
          },
          "col": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10"
          },
          "clr": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "pin": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "bpend": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{M}} && query.orderByChild === 'u' && query.equalTo === auth.uid",
        ".indexOn": [
          "u"
        ],
        "$pid": {
          ".read": "auth != null && data.child('u').val() === auth.uid",
          ".write": "{{BPENDW}}",
          ".validate": "newData.hasChildren(['u', 't']) && newData.child('u').isString() && newData.child('t').isNumber()",
          "u": {
            ".validate": true
          },
          "t": {
            ".validate": true
          },
          "e": {
            ".validate": "newData.isNumber()"
          },
          "ti": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "tx": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "img": {
            ".validate": "newData.val() === true"
          },
          "col": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10"
          },
          "clr": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "bimg": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        "$pid": {
          ".read": "{{BSEE}} || (auth != null && root.child('bpend/' + $bid + '/' + $pid + '/u').val() === auth.uid)",
          ".write": "{{BIMGW}}"
        }
      }
    },
    "bcmt": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}}",
        "$pid": {
          ".write": "{{BWITHPOST}}",
          "$cid": {
            ".write": "{{BCMTW}}",
            ".validate": "newData.hasChildren(['u', 't', 'tx'])",
            "u": {
              ".validate": "newData.isString()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "tx": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "brx": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}}",
        "$pid": {
          ".write": "{{BWITHPOST}}",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && {{BSEE}} && {{BRD}}.child('rx').val() !== false && root.child('bposts/' + $bid + '/' + $pid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 8"
          }
        }
      }
    },
    "btopic": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "bwrite": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}} && {{BRD}}.child('share').val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$tid": {
            ".write": "{{BWRITEW}}",
            ".validate": "newData.hasChildren(['t', 'st'])",
            "tx": {
              ".validate": "newData.isString() && newData.val().length <= 5000"
            },
            "ti": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "img": {
              ".validate": "newData.val() === true"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "e": {
              ".validate": "newData.isNumber()"
            },
            "st": {
              ".validate": "newData.val() === 'wait' || newData.val() === 'ok' || newData.val() === 'back'"
            },
            "fb": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "rt": {
              ".validate": "newData.isNumber()"
            },
            "lid": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "bwimg": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}} && {{BRD}}.child('share').val() === true",
        "$uid": {
          "$tid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "{{BWIMGW}}"
          }
        }
      }
    },
    "hanjaRanks": {
      ".read": "auth != null && (root.child('users/' + auth.uid).exists() || root.child('config/teacher').val() === auth.uid)",
      ".write": "auth != null && root.child('config/teacher').val() === auth.uid",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('users/' + auth.uid).exists()",
        ".validate": "newData.hasChildren(['score','level','learned','mastered','baseline','current','growth','assessedAt','hasRecheck']) && newData.child('score').val() === root.child('hanja/' + $uid + '/score').val() && newData.child('level').val() === root.child('hanja/' + $uid + '/level').val() && newData.child('learned').val() === root.child('hanja/' + $uid + '/learned').val() && newData.child('baseline').val() === root.child('hanja/' + $uid + '/baseline/right').val() && newData.child('mastered').val() >= 0 && newData.child('mastered').val() <= 300 && newData.child('growth').val() === newData.child('current').val() - newData.child('baseline').val()"
      }
    }
  }
}